# ---- environments ----
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ---- data (regenerate via scripts/generate_data.py) ----
# The synthetic generator writes here; nothing under data/ is committed
# because the generator is deterministic (fixed seed) and reproducible.
data/raw/*
data/interim/*
data/processed/*
!data/raw/.gitkeep

# ---- model artifacts & experiment stores (heavy binaries) ----
models/
mlruns/
*.joblib
*.pkl

# Heavy report payloads: figures/metrics are committed; raw per-brand
# prediction parquets are regenerated by scripts/score_prospects.py
reports/scoring/predictions.parquet
reports/scoring/rejected_brands.parquet

# ---- OS noise ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Editors ----
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/

# NOTE: reports/figures and reports/metrics ARE committed on purpose
# so the GitHub repo shows results without re-running the pipeline.
